#cloud-config
autoinstall:
  version: 1
  identity:
    hostname: ubuntu-desktop-template
    username: packer
    password: "$6$rounds=4096$REPLACE_WITH_REAL_HASH"
  ssh:
    install-server: true
    allow-pw: true
  storage:
    layout:
      name: direct
  packages:
    - qemu-guest-agent
  late-commands:
    - curtin in-target --target=/target -- systemctl enable qemu-guest-agent
